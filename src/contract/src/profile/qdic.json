  "slots": [
    {
      "slot": "physical_name",
      "keys": [
        "physical_name",
        "physicalName",
        "table_name",
        "asset_name",
        "name"
      ],
      "labelFallback": true,
      "source": {
        "doc": "SA-Intro",
        "section": "Browsing before you write anything",
        "note": "Design: the field labelFallback comes from the mockup app.js line 658 (the physical name falls back to the node label), ddr-0050 and ddr-0053."
      }
    },
    {
      "slot": "logical_name",
      "keys": [
        "logical_name",
        "logicalName",
        "business_name",
        "display_name",
        "displayName"
      ],
      "assetOnlyKeys": ["title"],
      "strong": true,
      "source": {
        "doc": "SA-Intro",
        "section": "Scenario A: Classify CUSTOMER_EMAIL as PII",
        "note": "Design: the field strong comes from the mockup app.js SLOTS line 582, ddr-0050 and ddr-0053. The field assetOnlyKeys comes from ddr-0053 and ruling 5: a broad alias such as title applies only to asset types."
      }
    },
    {
      "slot": "description",
      "keys": ["description", "desc", "summary"],
      "source": {
        "doc": "GV",
        "section": "Attributes"
      }
    },
    {
      "slot": "owners",
      "keys": ["owners", "owner", "data_owner"],
      "edge": "ownedBy",
      "strong": true,
      "itemName": [
        {
          "paths": [["given_name"], ["family_name"]],
          "join": " "
        },
        {
          "paths": [["name"]],
          "join": ""
        },
        {
          "paths": [["label"]],
          "join": ""
        },
        {
          "paths": [["email"]],
          "join": ""
        },
        {
          "paths": [["email_address"]],
          "join": ""
        }
      ],
      "source": {
        "doc": "GV",
        "section": "Predicates",
        "note": "Design: the fields strong and itemName come from the mockup app.js SLOTS line 584 and personName line 569, ddr-0050 and ddr-0053. The itemName alternative email comes from GV Node Types, user: \"email\"."
      }
    },
    {
      "slot": "tags",
      "keys": ["tags", "keywords"],
      "edge": "taggedWith",
      "assetOnlyKeys": ["labels"],
      "strong": true,
      "itemName": [
        {
          "paths": [
            ["parent_tag", "label"],
            ["child_tag", "label"]
          ],
          "join": " / "
        },
        {
          "paths": [["label"]],
          "join": ""
        },
        {
          "paths": [["name"]],
          "join": ""
        }
      ],
      "source": {
        "doc": "GV",
        "section": "Predicates",
        "note": "Design: the fields strong and itemName come from the mockup app.js SLOTS line 586 and tagName line 570, ddr-0050 and ddr-0053. The field assetOnlyKeys comes from ddr-0053 and ruling 5: a broad alias such as labels applies only to asset types."
      }
    },
    {
      "slot": "path",
      "keys": ["directory_path", "path", "qualified_name", "fqn"],
      "derive": "path",
      "strong": true,
      "source": {
        "doc": "GV",
        "section": "Predicates",
        "note": "Derived. The asset hierarchy is the contains predicate (database to schema, schema to table, table to column). The path is the chain of containers that you find when you follow contains in the inbound direction. Design: the field strong comes from the mockup app.js SLOTS line 587, ddr-0050 and ddr-0053."
      }
    },
    {
      "slot": "data_source",
      "keys": ["data_source", "data_source_name"],
      "late": ["service_name", "data_source_id"],
      "derive": "source",
      "source": {
        "doc": "GV",
        "section": "Node Types",
        "note": "Derived. GV defines the node type data_source but no graph pairing links it to an asset yet. The slot reads the data_source key first and the late key service_name second; the derive finds the data_source node when GV adds that link."
      }
    },
    {
      "slot": "parent_owners",
      "keys": ["parent_owners"],
      "derive": "parent-owners",
      "edge": "ownedBy",
      "itemName": [
        {
          "paths": [["given_name"], ["family_name"]],
          "join": " "
        },
        {
          "paths": [["name"]],
          "join": ""
        },
        {
          "paths": [["label"]],
          "join": ""
        },
        {
          "paths": [["email"]],
          "join": ""
        },
        {
          "paths": [["email_address"]],
          "join": ""
        }
      ],
      "source": {
        "doc": "GV",
        "section": "Predicates",
        "note": "Derived. The native parent_owners key comes first. If it is not present, the owners are the ownedBy objects of the nearest container, found when you follow contains in the inbound direction. The field edge names the predicate that the engine reads on that nearest container, never on the node itself. The field itemName comes from the mockup app.js line 585 and personName line 569. The itemName alternative email comes from GV Node Types, user: \"email\"."
      }
    },
    {
      "slot": "data_type",
      "keys": ["data_type", "dataType"],
      "source": {
        "doc": "GV",
        "section": "Attributes"
      }
    },

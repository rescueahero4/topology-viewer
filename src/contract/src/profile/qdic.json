  "shapeHeuristics": [
    {
      "kind": "rows",
      "columns": ["source", "target"],
      "predicate": "relatedTo",
      "hintDefault": true,
      "source": {
        "doc": "PRD",
        "section": "FR-DATA-10",
        "note": "The field predicate is relatedTo: PRD FR-DATA-10 names relatedTo and contains as the predicates that the shaper makes, and epic Q6 gives this predicate to each edge that the entry makes. The field hintDefault makes this entry the default of a rows hint with no predicate (STORY-002-09 open question 12)."
      }

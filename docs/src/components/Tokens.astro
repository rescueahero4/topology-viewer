---
// Every public token with its default, read from the CSS of the package when the site builds.
const sheets = import.meta.glob<string>("../../../src/ui/*.css", {
  query: "?raw",
  import: "default",
  eager: true,
});

const found = new Map<string, string>();
const TOKEN = /var\(\s*--tv-([\w-]+)\s*,\s*([\s\S]*?)\)\s*[;\n]/g;
for (const css of Object.values(sheets))
  for (const [, name, value] of css.matchAll(TOKEN))
    if (name !== undefined && value !== undefined && !found.has(name))
      found.set(name, value.replace(/\s+/g, " ").trim());
if (found.size < 50) throw new Error(`Only ${found.size} tokens found: the pattern is out of date`);

const GROUPS: readonly [string, RegExp][] = [
  ["Frame", /^(frame-|fullscreen)/],
  ["Type", /^font/],
  ["Shape and shadow", /^(radius|shadow)/],
  ["Motion", /^motion/],
  ["Surfaces", /^(canvas$|surface|card-bg|overlay-bg|backdrop)/],
  ["Lines", /^(border|rule)/],
  ["Text", /^(text|control-text|pill-text|predicate-text|link)/],
  ["States", /^(accent|focus|danger|warning|picked)/],
  ["Canvas", /^(node-|group-|badge|chip-|edge-|lost-)/],
  ["Tooltip", /^tooltip/],
  ["Table", /^(table-|handle-)/],
  ["AI marks", /^ai-/],
  ["Families", /^family-/],
];

const key = (name: string) =>
  name.replace(/-([a-z0-9])/g, (_, one: string) => one.toUpperCase());
const isColour = (value: string) => /^(#|rgb|hsl)/.test(value);

const groups = GROUPS.map(([title, pattern]) => ({
  title,
  rows: [...found.entries()].filter(([name]) => pattern.test(name)).sort(([a], [b]) => (a < b ? -1 : 1)),
}));
const listed = new Set(groups.flatMap((group) => group.rows.map(([name]) => name)));
const lost = [...found.keys()].filter((name) => !listed.has(name));
if (lost.length > 0) throw new Error(`Tokens with no group: ${lost.join(", ")}`);
---

{
  groups.map((group) => (
    <>
      <h2 id={group.title.toLowerCase().replace(/\W+/g, "-")}>{group.title}</h2>
      <table class="api-table">
        <thead>
          <tr><th>CSS token</th><th>Default</th><th>Key in <code>theme</code></th></tr>
        </thead>
        <tbody>
          {group.rows.map(([name, value]) => (
            <tr>
              <td><code>--tv-{name}</code></td>
              <td>
                {isColour(value) && <span class="token-swatch" style={`background:${value}`} />}
                <code>{value}</code>
              </td>
              <td><code>{key(name)}</code></td>
            </tr>
          ))}
        </tbody>
      </table>
    </>
  ))
}
